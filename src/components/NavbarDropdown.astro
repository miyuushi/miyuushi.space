---
import type { NavLink } from "@/types";
import { Dropdown as DropdownContainer, DropdownItems } from "astro-navbar";

interface Props {
  title: string;
  lastItem?: boolean;
  children: NavLink[];
}

const { title, lastItem, children } = Astro.props;
---

<li class="list-none w-full">
  <DropdownContainer class="md:relative group flex items-center justify-center flex-col">
    <button
      class="flex items-center gap-1 md:w-auto text-foreground/60 hover:text-foreground capitalize transition-colors duration-300 ease-in-out">
      <span>{title}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="3"
        stroke="currentColor"
        class="w-3 h-3 mt-0.5 group-open:rotate-180">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </button>
    <DropdownItems>
      <div
        class:list={[
          "md:absolute w-full md:w-48 z-10",
          lastItem
            ? "md:right-0 origin-top-right"
            : "md:left-0 origin-top-left",
        ]}>
        <div
          class="px-3 md:py-2 md:bg-background md:rounded-md md:shadow-sm md:border flex flex-col">
          {
            children.map((item) => (
              <a
                href={item.href}
                class="py-1 text-foreground/60 hover:text-foreground capitalize transition-colors">
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
    </DropdownItems>
  </DropdownContainer>
</li>
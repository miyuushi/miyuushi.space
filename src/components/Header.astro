---
import Dropdown from '@components/NavbarDropdown.astro';
import Link from '@components/Link.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import { NAV_LINKS, SITE } from '@/consts';
import { Image } from 'astro:assets';
import logo from '../../public/static/logo.svg';
---

<div>
  <nav
    class="mx-auto flex flex-wrap max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <Link href="/" class="flex shrink-0 items-center justify-center gap-3">
      <Image src={logo} alt="Logo" class="size-5 sm:size-6" />
      <span
        class="hidden h-full text-lg leading-none font-medium min-[400px]:block"
        >{SITE.title}</span
      >
    </Link>
    <div class="flex items-center lg:order-2">
      <ThemeToggle transition:persist />
      <button id="mobile-menu-button" data-collapse-toggle="mobile-menu-2" type="button"
        class="inline-flex items-center p-2 ml-1 text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-700"
        aria-controls="mobile-menu-2" aria-expanded="false">
        <span class="sr-only">Open main menu</span>
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd"
            d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
            clip-rule="evenodd"></path>
        </svg>
        <svg class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
            clip-rule="evenodd"></path>
        </svg>
      </button>
    </div>
    <div id="mobile-menu-2" class="flex items-center justify-between gap-4 w-full lg:flex lg:w-auto lg:order-1 lg:ml-auto hidden">
      <ul class="flex flex-col lg:flex-row items-center w-full gap-4 text-sm sm:gap-6 text-center">
        {
          NAV_LINKS.map((item, index) => (
            <>
              {item.children && (
                <Dropdown
                  title={item.label}
                  children={item.children}
                  lastItem={index === NAV_LINKS.length - 1}
                />
              )}

              {!item.children && (
                <li>
                  <Link
                    href={item.href}
                    class="text-foreground/60 hover:text-foreground capitalize transition-colors"
                  >
                    {item.label}
                  </Link>
                </li>
              )}
            </>
          ))
        }
      </ul>
    </div>
  </nav>
</div>

<script>
  function toggleMobileMenu() {
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu-2');

    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // Dropdown menu toggle
    const dropdownItem = document.querySelectorAll(".astronav-dropdown");
    dropdownItem.forEach((item) => {
      const dropdownMenu = item.querySelector(".dropdown-toggle");
      item.addEventListener("click", () => {
        dropdownMenu?.classList.toggle("hidden");
      });

      // Close the dropdown when clicking outside of it
      document.addEventListener("click", (e) => {
        if (!item.contains(e.target as Element)) {
          dropdownMenu?.classList.add("hidden");
        }
      });
    });
  }
  // Initialize on first load
  toggleMobileMenu();
  // Re-initialize after swapping pages
  document.addEventListener("astro:after-swap", toggleMobileMenu)
</script>


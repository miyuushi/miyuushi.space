---
import '@styles/starwind.css';
import '@styles/typography.css';
import Header from '@components/Header.astro';
import { cn } from '@/lib/utils';
import Head from '@/components/Head.astro';
import Footer from '@/components/Footer.astro';

interface Props {
	class?: string
}

const { class: className } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-background text-foreground scheme-light-dark dark">
	<head>
		<!-- <meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Astro Basics</title>
		<ClientRouter /> -->
		<Head>
			<slot name="head" />
		</Head>
	</head>
	<body class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
		<header class="bg-background/50 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none">
      <Header />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
		<main class={cn("w-full flex grow flex-col gap-y-6 px-4 mx-auto", className)}>
			<slot />
		</main>
		<Footer />
	</body>
</html>